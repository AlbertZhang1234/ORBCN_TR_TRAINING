# Invoice processing backend

INVOICE_SERVICE_HOST=127.0.0.1
INVOICE_SERVICE_PORT=8201
INVOICE_MAX_UPLOAD_MB=20
# PDF/image processing runs in isolated processes (1-4); restart after changing.
INVOICE_PREPROCESS_WORKERS=2
# Optional absolute override when Backend/log is mounted elsewhere.
# BACKEND_LOG_DIR=/app/log

# LLM backend settings
backend_llm_baseurl=https://your-llm-endpoint/v1
backend_llm_apikey=your_llm_api_key
backend_llm_model=your_llm_model

# Optional OpenAI-compatible naming
OPENAI_API_KEY=your_llm_api_key
INVOICE_LLM_BASE_URL=https://your-llm-endpoint/v1
INVOICE_LLM_MODEL=your_llm_model
INVOICE_LLM_TEMPERATURE=0
