# Frontend / Next.js runtime

# Database / Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
DATABASE_URL=postgres://postgres:your_database_password@your-project.supabase.co:5432/postgres

# Optional production reference
# NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_prod_supabase_anon_key
# DATABASE_URL=postgres://postgres:your_prod_database_password@your-prod-project.supabase.co:5432/postgres

# Invoice parse service
NEXT_PUBLIC_INVOICE_PARSE_ENDPOINT=http://127.0.0.1:8201/api/v1/invoice/classify

# Exchange rate API for foreign invoice conversion
exchg_apikey=your_exchangerate_api_key

# LLM API
NEXT_PUBLIC_LLM_BASEURL=http://127.0.0.1:8666/v1
NEXT_PUBLIC_LLM_APIKEY=your_llm_api_key
NEXT_PUBLIC_LLM_MODEL=your_llm_model

# Public URL for reset links and approval links
PASSWORD_RESET_BASE_URL=https://tr.example.com
NEXT_PUBLIC_BASE_URL=https://tr.example.com

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_VERIFY_TLS=true
SMTP_USER=bot@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="OTTO BOT" <bot@example.com>

# Finance recipient
TR_REIMBURSEMENT_TO=finance@example.com

# Backward-compatible recipient key still read by the code
NEXT_PUBLIC_TR_RECEIVER=finance@example.com

# QXB / external company lookup
QXB_URL=https://your-proxy.example.com/webhook/api/qixin
QXB_USER=your_qxb_user
QXB_PASSWORD=your_qxb_password

# Optional lowercase compatibility keys if your existing environment already uses them
qxb_url=https://your-proxy.example.com/webhook/api/qixin
qxb_user=your_qxb_user
qxb_password=your_qxb_password
